# Antigravity Architecture (Layer 3 - Workspaces & Secrets)
**/Workspace/*
!**/Workspace/.gitkeep
**/.secrets/*
!**/.secrets/.gitkeep

# Secrets & Env files
.env
.env.*
*.env
.secrets/
secrets/
credentials*
*.pem
*.key

