# Antigravity Architecture (Layer 3 - Workspaces & Secrets)
**/Workspace/*
!**/Workspace/.gitkeep
**/.secrets/*
!**/.secrets/.gitkeep

# Secrets & Env files
.env
.env.*
*.env
.secrets/
secrets/
credentials*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
venv/
.venv/
env/
.env/

# Node / JS
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
.turbo/

