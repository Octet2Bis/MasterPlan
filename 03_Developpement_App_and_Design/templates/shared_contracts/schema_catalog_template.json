{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MasterPlanCatalogSchema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "category", "durationSeconds"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z0-9_-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 3
      },
      "subtitle": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "durationSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600
      },
      "scientificSource": {
        "type": "string"
      },
      "xpReward": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
